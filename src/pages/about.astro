---
import StackChip from "../components/StackChip.astro";
import ExternalCard from "../components/ExternalCard.astro";
import RichText from "../components/RichText.astro";
import { site } from "../data/site";
import Layout from "../layouts/Layout.astro";
---

<Layout title="About" description={site.about.subtitle}>
	<section>
		<h1 class="font-bold text-3xl font-serif">About Me</h1>
		<p class="text-neutral-500 dark:text-neutral-400 text-sm mt-1">{site.about.subtitle}</p>
		<div class="prose prose-neutral dark:prose-invert text-neutral-800 dark:text-neutral-200 mt-6">
			{site.about.paragraphs.map((text) => (
				<p>
					<RichText text={text} />
				</p>
			))}
			<hr />
			{site.about.afterHr.map((text) => (
				<p>
					<RichText text={text} />
				</p>
			))}
		</div>
		<div class="mt-10">
			<p class="text-sm font-medium text-neutral-900 dark:text-neutral-100 mb-6">
				{site.about.stackLabel}
			</p>
			<div class="flex flex-col gap-8">
				{
					site.about.stackGroups.map((group) => (
						<div>
							<p class="font-mono text-xs text-neutral-400 dark:text-neutral-500">
								{group.id}
							</p>
							<h2 class="font-serif font-bold text-lg mt-1 mb-3 tracking-wide">
								{group.title}
							</h2>
							<div class="flex flex-wrap gap-2">
								{group.items.map((item) => (
									<StackChip label={item.label} slug={item.slug} />
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
		<div class="mt-8 flex flex-col gap-2 md:flex-row md:gap-2">
			{site.socials.map((item) => <ExternalCard item={item} />)}
		</div>
	</section>
</Layout>
