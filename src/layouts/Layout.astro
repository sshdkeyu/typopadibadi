---
import { ClientRouter } from "astro:transitions";
import DraggableMoments from "../components/DraggableMoments";
import Sidebar from "../components/Sidebar.astro";
import AmbientSound from "../components/AmbientSound.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	moments?: boolean;
}

const { title, description = site.description, moments = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const pathname = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(site.og.image, site.url).href;
const ogTitle = pageTitle;
---

<!doctype html>
<html lang="en" class="text-black bg-white dark:text-white dark:bg-[#111010]">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=ollama" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#111010" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="en-US" />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(site.og.width)} />
		<meta property="og:image:height" content={String(site.og.height)} />
		<meta property="og:image:alt" content={site.og.alt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={site.og.alt} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Kaisei+Tokumin:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<ThemeScript />
		<ClientRouter />
	</head>
	<body
		class:list={[
			"antialiased w-full max-w-4xl mx-auto mb-40 flex flex-col lg:flex-row px-4",
			moments && "overflow-x-hidden",
		]}
	>
		{
			moments && (
				<DraggableMoments client:only="react" items={site.moments.items} />
			)
		}
		<AmbientSound />
		<ThemeToggle />
		<Sidebar pathname={pathname} />
		<main
			class:list={[
				"flex-auto min-w-0 pt-4 lg:pt-20 xl:pt-32 flex flex-col px-0",
				moments &&
					"relative z-20 pointer-events-none [&_a]:pointer-events-auto [&_img]:pointer-events-auto",
			]}
			transition:animate="fade"
		>
			<slot />
		</main>
	</body>
</html>
