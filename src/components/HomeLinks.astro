---
import type { HomeLink } from "../data/site";
import ArrowIcon from "./ArrowIcon.astro";

interface Props {
	links: readonly HomeLink[];
}

const { links } = Astro.props;
---

<ul
	class="flex flex-col md:flex-row mt-8 space-x-0 md:space-x-4 space-y-2 md:space-y-0 font-sm text-neutral-500 dark:text-neutral-400"
>
	{
		links.map((link) => (
			<li>
				<a
					class="flex items-center hover:text-neutral-700 dark:hover:text-neutral-200 transition-all"
					rel={link.external ? "noopener noreferrer" : undefined}
					target={link.external ? "_blank" : undefined}
					href={link.href}
				>
					<ArrowIcon />
					<p class="h-7">{link.label}</p>
				</a>
			</li>
		))
	}
</ul>
